---
// Busca da abertura: procura nos títulos das áreas e das notícias, sem servidor (a lista vai junto na página).
import Icone from './Icone.astro';
import { paginas, noticias } from '../conteudo';
import { RESUMO_AREA } from '../config';

const fora = ['contato', 'cartao-escritorio', 'consultoria-aldrigues-candido-advocacia'];
const dados = [
  ...paginas.filter((p) => !fora.includes(p.slug)).map((p) => ({ t: p.frontmatter.titulo, d: RESUMO_AREA[p.slug] ?? '', u: `/${p.slug}/`, k: 'Área' })),
  ...noticias.map((n) => ({ t: n.frontmatter.titulo, d: '', u: `/noticias/${n.slug}/`, k: 'Notícia' })),
];
---
<form class="busca" role="search" action="/areas-de-atuacao/" data-busca>
  <label for="busca-campo" class="so-leitor">O que você procura?</label>
  <input id="busca-campo" type="search" placeholder="O que você procura? Ex.: aposentadoria, FGTS" autocomplete="off"
    aria-controls="busca-resultados" aria-describedby="busca-status" />
  <button type="submit" aria-label="Buscar"><Icone nome="busca" tamanho={22} /></button>
  <ul id="busca-resultados" class="busca-resultados" hidden></ul>
  <p id="busca-status" class="so-leitor" aria-live="polite"></p>
  <script type="application/json" id="busca-dados" set:html={JSON.stringify(dados)} />
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-busca]');
  if (form) {
    const campo = form.querySelector('input')!;
    const lista = form.querySelector<HTMLUListElement>('#busca-resultados')!;
    const status = form.querySelector('#busca-status')!;
    const dados: { t: string; d: string; u: string; k: string }[] = JSON.parse(document.getElementById('busca-dados')!.textContent!);
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const base = dados.map((x) => ({ ...x, n: norm(x.t + ' ' + x.d) }));
    let achados: typeof base = [];

    campo.addEventListener('input', () => {
      const termos = norm(campo.value).split(/\s+/).filter((t) => t.length > 1);
      achados = termos.length ? base.filter((x) => termos.every((t) => x.n.includes(t))).slice(0, 6) : [];
      lista.replaceChildren(...achados.map((x) => {
        const li = document.createElement('li'), a = document.createElement('a'), s = document.createElement('small');
        a.href = x.u; a.textContent = x.t; s.textContent = x.k; a.prepend(s); li.append(a); return li;
      }));
      if (termos.length && !achados.length) {
        const li = document.createElement('li'); li.className = 'vazio';
        li.textContent = 'Nada encontrado. Fale com a gente pelo WhatsApp que explicamos.';
        lista.append(li);
      }
      lista.hidden = !termos.length;
      status.textContent = termos.length ? `${achados.length} resultado(s)` : '';
    });
    // Enter vai direto para o primeiro resultado
    form.addEventListener('submit', (e) => { if (achados[0]) { e.preventDefault(); location.href = achados[0].u; } });
    campo.addEventListener('keydown', (e) => { if (e.key === 'Escape') { campo.value = ''; campo.dispatchEvent(new Event('input')); } });
    document.addEventListener('click', (e) => { if (!form.contains(e.target as Node)) lista.hidden = true; });
    campo.addEventListener('focus', () => { if (campo.value.trim()) lista.hidden = false; });
  }
</script>
